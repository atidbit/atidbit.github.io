---
layout: null
---
{%- assign base = site.cats_site_url -%}
{%- assign memes = site.cat_memes | where_exp: "m", "m.date <= site.time" | sort: "date" | reverse -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>Daily Cat Memes</title>
    <link>{{ base }}/cats/</link>
    <description>One cat. One meme. Every day.</description>
    <language>en-us</language>
    <atom:link href="{{ base }}/cats/feed.xml" rel="self" type="application/rss+xml"/>
    {%- if memes.size > 0 %}
    <lastBuildDate>{{ memes.first.date | date_to_rfc822 }}</lastBuildDate>
    {%- endif %}
    {%- for m in memes limit:30 %}
    <item>
      <title>{{ m.title | xml_escape }}</title>
      <link>{{ base }}{{ m.url }}</link>
      <guid isPermaLink="true">{{ base }}{{ m.url }}</guid>
      <pubDate>{{ m.date | date_to_rfc822 }}</pubDate>
      {%- capture html -%}<p><img src="{{ base }}{{ m.image }}" alt="{{ m.alt | escape }}" width="{{ m.width }}" height="{{ m.height }}"></p><p>{{ m.caption | escape }}</p>{%- endcapture %}
      <description>{{ html | xml_escape }}</description>
      <media:content url="{{ base }}{{ m.image }}" medium="image" width="{{ m.width }}" height="{{ m.height }}">
        <media:description type="plain">{{ m.alt | xml_escape }}</media:description>
      </media:content>
      {%- if m.image_bytes %}
      <enclosure url="{{ base }}{{ m.image }}" length="{{ m.image_bytes }}" type="{% if m.image contains '.png' %}image/png{% elsif m.image contains '.webp' %}image/webp{% else %}image/jpeg{% endif %}"/>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
